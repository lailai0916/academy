NODE_ENV=development
PORT=4100
HOST=127.0.0.1
DATABASE_URL=postgres://academy:academy@127.0.0.1:5432/academy
APP_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=academy_session
SESSION_TTL_DAYS=30
AI_CONFIG_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
RUN_MIGRATIONS=false
TRUST_PROXY=false

# Docker Compose deployment values
ACADEMY_POSTGRES_DB=academy
ACADEMY_POSTGRES_USER=academy
ACADEMY_POSTGRES_PASSWORD=replace-with-a-random-password
ACADEMY_RELEASE=latest
